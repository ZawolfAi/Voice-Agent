APP_ENV=development
APP_NAME=careos-api
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://careos:change-me@localhost:5432/careos
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
# OpenAI can serve both chat and voice when AI_PROVIDER=openai.
SPEECH_TO_TEXT_PROVIDER=unconfigured
SPEECH_TO_TEXT_API_URL=
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_MODEL=gpt-4o-mini-transcribe
SPEECH_TO_TEXT_LANGUAGE=ar-EG
SPEECH_TO_TEXT_DIARIZATION=true
AI_PROVIDER=openai
AI_API_URL=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AUDIO_RETENTION_DAYS=30
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=
SAML_METADATA_URL=
SAML_ENTITY_ID=
AUDIT_RETENTION_DAYS=2555
BACKUP_BUCKET=
BACKUP_REGION=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_MAX_RETRIES=3
EMAIL_RETRY_BACKOFF_SECONDS=0.5
AUTH_RATE_LIMIT_REQUESTS=60
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
MAX_UPLOAD_BYTES=26214400
ALLOWED_UPLOAD_CONTENT_TYPES=application/pdf,audio/webm,audio/wav,audio/mpeg,image/png,image/jpeg
# External providers are configured by the deployment, never the frontend.
AI_API_KEY=
AI_BASE_URL=
OCR_PROVIDER=sandbox
NOTIFICATION_PROVIDER=sandbox
CORS_ORIGINS=http://localhost:5173
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
JWT_AUDIENCE=careos-api
